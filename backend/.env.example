# Copy these into your hosting provider's environment settings.
# (The app reads them from the environment; it does not load .env files itself.)

# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Database connection. Defaults to a SQLite file in the backend folder.
# DATABASE_URL=sqlite:///./campus_booking.db

# Comma-separated list of frontend URLs allowed to call the API. Defaults to "*".
# CORS_ORIGINS=https://your-frontend.example.com

# Login session length in minutes. Defaults to 120.
# ACCESS_TOKEN_EXPIRE_MINUTES=120
